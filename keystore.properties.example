# Copy this file to keystore.properties (gitignored) for local signed release builds.
#
# Generate the release keystore once (keep the .jks file backed up outside the repo):
#   mkdir -p keystore
#   keytool -genkeypair -v \
#     -keystore keystore/blissdeck-release.jks \
#     -alias blissdeck \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype JKS
#
# GitHub Actions secrets (Repository settings → Secrets and variables → Actions):
#   SIGNING_KEY            — single-line base64 of the keystore file (see below)
#   SIGNING_STORE_PASSWORD — keystore password
#   SIGNING_KEY_ALIAS      — blissdeck
#   SIGNING_KEY_PASSWORD   — key password
#
# Encode SIGNING_KEY (Linux):
#   base64 -w0 keystore/blissdeck-release.jks
# Copy the entire one-line output into the SIGNING_KEY secret (no quotes, no file path).
# If decode still fails, delete and re-create SIGNING_KEY from a fresh base64 -w0 run.

storeFile=keystore/blissdeck-release.jks
storePassword=CHANGE_ME
keyAlias=blissdeck
keyPassword=CHANGE_ME
